# ItamaRos Bot — Render variables (copy the keys, not the placeholders)
# Create real secrets ONLY in Render > Your Web Service > Environment.
# Do not commit or share actual tokens, client secrets, or MongoDB URIs.

# Already required by the bot
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
GUILD_ID=YOUR_DISCORD_SERVER_ID
MONGODB_URI=YOUR_PRIVATE_MONGODB_ATLAS_CONNECTION_STRING

# Required for the secured website dashboard
DISCORD_CLIENT_SECRET=YOUR_DISCORD_OAUTH2_CLIENT_SECRET
DASHBOARD_REDIRECT_URI=https://itamaros-tickets.onrender.com/admin/callback

# Optional radio voice channel override. The command
# /radio-admin set-channel saves the choice in MongoDB instead.
# RADIO_VOICE_CHANNEL_ID=YOUR_DISCORD_VOICE_CHANNEL_ID

# For automatic radio channel creation if the server lacks one
BOT_AUTO_CHANNELS=true

# Render sets PORT automatically for Web Services.
